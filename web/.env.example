# URL of the Python API (must match `reels serve --port …`)
# Examples:
#   VITE_API_BASE=http://127.0.0.1:8000
#   VITE_API_BASE=http://127.0.0.1:8080
VITE_API_BASE=http://127.0.0.1:8000

# Optional: where Vite proxies /api when VITE_API_BASE is unset (dev only)
# VITE_API_PROXY_TARGET=http://127.0.0.1:8000
